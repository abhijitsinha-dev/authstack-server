NODE_ENV=development
PORT=5000

// Database
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/

// Brevo (Email)
BREVO_API_KEY=xkeysib-...
BREVO_SENDER_EMAIL=no-reply@yourdomain.com
BREVO_SENDER_NAME=AuthStack

// Redis & Upstash
REDIS_URL=rediss://default:your-password@your-upstash-endpoint.upstash.io:6379
UPSTASH_REDIS_REST_URL=your_rest_url_here
UPSTASH_REDIS_REST_TOKEN=your_rest_token_here

// JWT Secrets
ACCESS_TOKEN_SECRET=your_super_secret_access_key_here
REFRESH_TOKEN_SECRET=your_super_secret_refresh_key_here
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
