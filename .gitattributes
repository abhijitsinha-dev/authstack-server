# ─────────────────────────────────────────────
# Default: Auto-detect text files and normalize line endings
# ─────────────────────────────────────────────
* text=auto

# ─────────────────────────────────────────────
# Explicitly force LF for source files
# (Critical for Vercel & cross-platform consistency)
# ─────────────────────────────────────────────
*.js      text eol=lf
*.mjs     text eol=lf
*.cjs     text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.sh      text eol=lf

# ─────────────────────────────────────────────
# Scripts that must NEVER have CRLF (Windows)
# ─────────────────────────────────────────────
*.sh      text eol=lf
*.bash    text eol=lf

# ─────────────────────────────────────────────
# Binary files (Git should never diff/merge these)
# ─────────────────────────────────────────────
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.webp    binary
*.svg     binary
*.woff    binary
*.woff2   binary
*.ttf     binary
*.eot     binary
*.pdf     binary
*.zip     binary
*.gz      binary
*.tar     binary

# ─────────────────────────────────────────────
# Lockfiles — mark as binary to avoid massive diffs
# ─────────────────────────────────────────────
package-lock.json  binary
yarn.lock          binary
pnpm-lock.yaml     binary
npm-shrinkwrap.json binary

# ─────────────────────────────────────────────
# Lockfiles — prevent automated merges (they regenerate)
# ─────────────────────────────────────────────
package-lock.json  merge=binary
yarn.lock          merge=binary
pnpm-lock.yaml     merge=binary
npm-shrinkwrap.json merge=binary

# ─────────────────────────────────────────────
# Prevent Git from showing these as "modified"
# (they are auto-generated)
# ─────────────────────────────────────────────
.vercel/**         export-ignore
.github/**         export-ignore
tests/**           export-ignore

# ─────────────────────────────────────────────
# Language & diff hints
# ─────────────────────────────────────────────
*.js      linguist-language=JavaScript
*.json    linguist-language=JSON
*.md      linguist-documentation