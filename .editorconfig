# ─────────────────────────────────────────────
# EditorConfig — https://editorconfig.org
# Aligned with .prettierrc.json
# ─────────────────────────────────────────────
root = true

# ─────────────────────────────────────────────
# Defaults for all files
# ─────────────────────────────────────────────
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# ─────────────────────────────────────────────
# JavaScript / Node.js source
# ─────────────────────────────────────────────
[*.{js,mjs,cjs}]
indent_size = 2

# ─────────────────────────────────────────────
# JSON / YAML / Config
# ─────────────────────────────────────────────
[*.{json,yml,yaml}]
indent_size = 2

# ─────────────────────────────────────────────
# Markdown — trailing whitespace can be meaningful
# (two trailing spaces = hard line break)
# ─────────────────────────────────────────────
[*.md]
trim_trailing_whitespace = false

# ─────────────────────────────────────────────
# Lockfiles are auto-generated — never edit formatting
# ─────────────────────────────────────────────
[{package-lock.json,yarn.lock,pnpm-lock.yaml}]
indent_size = 2

# ─────────────────────────────────────────────
# Shell scripts (must be LF, no CRLF)
# ─────────────────────────────────────────────
[*.sh]
end_of_line = lf