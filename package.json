{
  "name": "authstack-server",
  "version": "1.0.0",
  "description": "",
  "main": "./src/server.js",
  "scripts": {
    "dev": "node --env-file=.env --watch src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "worker": "node --env-file-if-exists=.env worker/index.js",
    "redis:clear": "node --env-file-if-exists=.env scripts/clear-redis.js",
    "vercel-build": "echo 'no build step'",
    "lint": "eslint .",
    "lint:cache": "eslint --cache .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules NODE_ENV=test jest --detectOpenHandles",
    "prepare": "husky"
  },
  "keywords": [
    "authstack"
  ],
  "author": "Abhijit Sinha",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": "^26"
  },
  "overrides": {
    "minimatch": "^11.0.4",
    "glob": "^14.0.2",
    "deepmerge": "npm:@stackline/deepmerge@^1.1.0"
  },
  "dependencies": {
    "@getbrevo/brevo": "^6.2.0",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.41.0",
    "@vercel/functions": "^3.10.6",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.7.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "joi": "^18.3.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.0",
    "morgan": "^1.12.1",
    "swagger-jsdoc": "^6.3.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.5.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "lint-staged": "^17.6.0",
    "mongodb-memory-server": "^11.3.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1"
  },
  "allowScripts": {
    "@scarf/scarf": false,
    "msgpackr-extract@3.0.7": true,
    "@parcel/watcher@2.6.0": true,
    "mongodb-memory-server@11.3.0": true
  }
}
